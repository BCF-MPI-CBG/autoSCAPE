    "\n",
    "shapes.face_color = [0,0,0,0]\n",
    "shapes.edge_width = 10\n",
    "shapes.units = viewer.layers[0].units\n",
    "viewer.add_layer(shapes)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Focus detection"
