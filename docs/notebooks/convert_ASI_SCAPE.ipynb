   "source": [
    "resolution_level = 2\n",
    "model = YOLO(r\"C:\\Users\\aifadmin\\Documents\\Github\\autoSCAPE\\docs\\notebooks\\archive\\runs\\detect\\train-6\\weights\\best.pt\")\n",
